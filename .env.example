# BLAZZID AI Studio - Environment Configuration Template
# Copy to .env for local runtime overrides. Do not commit secrets.

# Database Connection (PostgreSQL for containerized/production, SQLite for lightweight local dev)
DATABASE_URL=postgresql+psycopg://blazzid_user:blazzid_password@localhost:5432/blazzid_db
# For SQLite local development without Docker:
# DATABASE_URL=sqlite:///./blazzid_dev.db

# Redis Connection (Redis Streams queue)
REDIS_URL=redis://localhost:6379/0

# Storage Root Directory
STORAGE_ROOT=./data/storage

# Upload Constraints (Bytes)
MAX_UPLOAD_SIZE_BYTES=524288000

# Security / Authentication
# Environment mode: development | staging | production
BLAZZID_ENV=development
# Explicitly permit anonymous access for local development (strictly prohibited in production)
BLAZZID_ALLOW_ANONYMOUS_DEV=true
# Secret token required for Bearer authentication in production or secured environments
BLAZZID_AUTH_SECRET=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=*

# Worker Configuration
WORKER_ID=worker-local-01
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SEC=30.0
